[Unit]
Description=Pokemon wiki server (YeaSrine/PokemonEbonyphantomEXBW5.0 tools/serve.py)
PartOf=hyprland-session.target
After=hyprland-session.target

[Service]
Type=simple
# serve.py 自己按 __file__ 定位 ROOT，与 cwd 无关；写 WorkingDirectory 只为
# 日志里 cwd 可读，以及它 spawn battle_watch.py 时继承过去
WorkingDirectory=/home/Sakurine/YeaSrine/PokemonEbonyphantomEXBW5.0
# PYTHONUNBUFFERED：默认 stdout 是块缓冲，journalctl 里那两行启动信息要等
# 缓冲区满才出现（服务不退出就永远看不到）。-u 让它们当场落进 journal
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/Sakurine/YeaSrine/PokemonEbonyphantomEXBW5.0/tools/serve.py 8931
Restart=on-failure
RestartSec=5

[Install]
WantedBy=hyprland-session.target

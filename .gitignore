# color.conf：我的配色速记，开发/写主题时翻
color.conf

# secrets
.env

# ============================================================
# 个人化资源（其他用户应自行准备）
# ============================================================

# 我机器上的 fastfetch logo 是个人收藏，不公开
fastfetch/logo

# GTK 书签是本地路径
gtk-3.0/bookmarks

# ============================================================
# 由程序运行时生成的缓存 / 状态
# ============================================================

# Python 字节码
__pycache__/
*.pyc

# nvim lazy-lock：每次插件升级都会变，按个人习惯不入库
lazy-lock.json

# fcitx5 rime 自动生成的快照/缓存，以及个人词库
fcitx5/rime/*_cleanup_*.txt
fcitx5/rime/worddb_snapshot_*.txt
fcitx5/rime/custom_phrase.txt

# 动态切换主题（matugen 在运行时写出的成品，模板在 matugen/templates/ 下不受影响）
/gtk-3.0/gtk.css
/gtk-4.0/gtk.css

# GTK 自己会回写 settings.ini（gtk-application-prefer-dark-theme 这类开关，
# 改主题、动一下设置类程序就变），入库只会一直脏在 git status 上
/gtk-3.0/settings.ini
/gtk-4.0/settings.ini

{
  "groups": [
    {
      "id": "hypr",
      "title": "Hypr",
      "sections": [
        {
          "id": "layout",
          "title": "布局管理",
          "items": [
            { "keys": "Super+S", "desc": "切换 dwindle / scrolling" }
          ]
        },
        {
          "id": "window",
          "title": "窗口管理",
          "items": [
            { "keys": "Super+Q", "desc": "关闭当前窗口" },
            { "keys": "Super+W", "desc": "切换浮动" },
            { "keys": "Super+M", "desc": "退出 Hyprland" }
          ]
        },
        {
          "id": "power",
          "title": "电源管理",
          "items": [
            { "keys": "Super+Space", "desc": "电源菜单" },
            { "keys": "Super+L", "desc": "锁屏" }
          ]
        },
        {
          "id": "apps",
          "title": "应用启动",
          "items": [
            { "keys": "Super+T", "desc": "终端" },
            { "keys": "Super+E", "desc": "文件管理器" },
            { "keys": "Super+B", "desc": "浏览器" }
          ]
        },
        {
          "id": "panels",
          "title": "快捷面板",
          "items": [
            { "keys": "Super+A", "desc": "应用启动器" },
            { "keys": "Super+Z", "desc": "剪贴板" },
            { "keys": "Super+X", "desc": "Web 搜索" }
          ]
        },
        {
          "id": "sidebar",
          "title": "侧栏与通知",
          "items": [
            { "keys": "Super+C", "desc": "左侧栏" },
            { "keys": "Super+V", "desc": "右侧栏" },
            { "keys": "Super+N", "desc": "通知中心" }
          ]
        },
        {
          "id": "island",
          "title": "灵动岛",
          "items": [
            { "keys": "Alt+Tab", "desc": "Hub 主视图" },
            { "keys": "Super+Tab", "desc": "窗口切换器" },
            { "keys": "Super+G", "desc": "一级岛置顶开关" }
          ]
        },
        {
          "id": "capture",
          "title": "屏幕截图",
          "items": [
            { "keys": "Ctrl+Alt+A", "desc": "区域截图" },
            { "keys": "Ctrl+Alt+Q", "desc": "全屏截图" }
          ]
        },
        {
          "id": "media",
          "title": "媒体控制",
          "items": [
            { "keys": "Ctrl+Alt+D", "desc": "播放 / 暂停" },
            { "keys": "Ctrl+Alt+Left", "desc": "上一首" },
            { "keys": "Ctrl+Alt+Right", "desc": "下一首" }
          ]
        },
        {
          "id": "wallpaper",
          "title": "壁纸控制",
          "items": [
            { "keys": "Ctrl+Alt+N", "desc": "下一张壁纸" },
            { "keys": "Ctrl+Alt+P", "desc": "上一张壁纸" },
            { "keys": "Ctrl+Alt+S", "desc": "切换 image / video 模式" }
          ]
        },
        {
          "id": "workspace",
          "title": "工作区跳转",
          "items": [
            { "keys": "Super+Shift+Left", "desc": "上一个非空工作区" },
            { "keys": "Super+Shift+Right", "desc": "下一个非空工作区" },
            { "keys": "Super+Shift+Down", "desc": "下一个空工作区" },
            { "keys": "Super+Shift+Up", "desc": "上一个空工作区" },
            { "keys": "Super+1..0", "desc": "聚焦工作区 1–10（0=10）" }
          ]
        },
        {
          "id": "focus-move",
          "title": "焦点与移动",
          "items": [
            { "keys": "Super+Shift+1..0", "desc": "窗口移到工作区 1–10" },
            { "keys": "Super+Left/Right/Up/Down", "desc": "移动焦点" },
            { "keys": "Super+Alt+Left/Right/Up/Down", "desc": "移动窗口" },
            { "keys": "Super+R", "desc": "进入键盘调大小模式" },
            { "keys": "←→↑↓（调大小时）", "desc": "调整窗口大小" },
            { "keys": "Esc / Enter / Super+R", "desc": "退出调大小模式" }
          ]
        },
        {
          "id": "mouse",
          "title": "鼠标操作",
          "items": [
            { "keys": "Super+左键", "desc": "拖拽窗口" },
            { "keys": "Super+右键", "desc": "调整窗口大小" }
          ]
        }
      ]
    },
    {
      "id": "nvim",
      "title": "Neovim",
      "sections": [
        {
          "id": "search",
          "title": "搜索（Leader=Space）",
          "items": [
            { "keys": "Space+ff", "desc": "搜索文件 (Telescope)" },
            { "keys": "Space+fg", "desc": "全文搜索" },
            { "keys": "Space+fb", "desc": "切换 Buffer" },
            { "keys": "Space+fh", "desc": "搜索帮助" }
          ]
        },
        {
          "id": "tree",
          "title": "文件树",
          "items": [
            { "keys": "Space+w", "desc": "开关文件树" },
            { "keys": "Space+e", "desc": "文件树 ↔ 编辑区焦点" },
            { "keys": "v（树内）", "desc": "竖分屏打开文件" }
          ]
        },
        {
          "id": "lsp",
          "title": "LSP / 诊断",
          "items": [
            { "keys": "K", "desc": "悬停文档" },
            { "keys": "Space+dd", "desc": "诊断浮窗" },
            { "keys": "]d", "desc": "下一处诊断" },
            { "keys": "[d", "desc": "上一处诊断" }
          ]
        },
        {
          "id": "edit",
          "title": "补全",
          "items": [
            { "keys": "Tab", "desc": "补全下一项" },
            { "keys": "Shift+Tab", "desc": "补全上一项" },
            { "keys": "Enter", "desc": "确认补全" },
            { "keys": "Ctrl+Space", "desc": "手动触发补全" }
          ]
        }
      ]
    },
    {
      "id": "kitty",
      "title": "Kitty",
      "sections": [
        {
          "id": "splits",
          "title": "分屏",
          "items": [
            { "keys": "Ctrl+Shift+Enter", "desc": "上下分屏" },
            { "keys": "Ctrl+Shift+\\", "desc": "左右分屏" },
            { "keys": "Ctrl+Shift+W", "desc": "关闭当前 split" },
            { "keys": "Ctrl+Shift+Z", "desc": "切换 splits ↔ stack" }
          ]
        },
        {
          "id": "nav",
          "title": "焦点",
          "items": [
            { "keys": "Ctrl+Shift+Left", "desc": "焦点左移" },
            { "keys": "Ctrl+Shift+Right", "desc": "焦点右移" },
            { "keys": "Ctrl+Shift+Up", "desc": "焦点上移" },
            { "keys": "Ctrl+Shift+Down", "desc": "焦点下移" }
          ]
        },
        {
          "id": "resize",
          "title": "调大小（焦点在 Kitty 时）",
          "items": [
            { "keys": "Ctrl+Alt+Left", "desc": "加宽" },
            { "keys": "Ctrl+Alt+Right", "desc": "变窄" },
            { "keys": "Ctrl+Alt+Up", "desc": "加高" },
            { "keys": "Ctrl+Alt+Down", "desc": "变矮" },
            { "keys": "Ctrl+Alt+R", "desc": "重置窗口大小" }
          ]
        }
      ]
    },
    {
      "id": "fcitx5",
      "title": "输入法",
      "sections": [
        {
          "id": "switch",
          "title": "切换",
          "items": [
            { "keys": "Ctrl+Space", "desc": "激活 / 关闭输入法" },
            { "keys": "CapsLock", "desc": "清组并切英文（已禁 Shift 切 ASCII）" }
          ]
        },
        {
          "id": "candidates",
          "title": "候选 / 翻页",
          "items": [
            { "keys": "Tab", "desc": "下一候选" },
            { "keys": "Shift+Tab", "desc": "上一候选" },
            { "keys": "↑ / ↓", "desc": "上一页 / 下一页" },
            { "keys": "Ctrl+Alt+P", "desc": "切换预编辑" }
          ]
        },
        {
          "id": "rime",
          "title": "Rime",
          "items": [
            { "keys": "F4", "desc": "方案选单" },
            { "keys": "Ctrl+`", "desc": "方案选单" },
            { "keys": "Ctrl+Shift+3", "desc": "中英标点切换" },
            { "keys": "Ctrl+Shift+4", "desc": "简繁切换" },
            { "keys": "Ctrl+.", "desc": "半角标点开关" }
          ]
        }
      ]
    },
    {
      "id": "ipc",
      "title": "IPC",
      "sections": [
        {
          "id": "ipc-usage",
          "title": "qs ipc call <target> <method>",
          "items": [
            { "keys": "qs ipc show", "desc": "列出全部 target" }
          ]
        },
        {
          "id": "ipc-island",
          "title": "island — 灵动岛",
          "items": [
            { "keys": "island hub", "desc": "开关 Hub" },
            { "keys": "island close", "desc": "关闭 Hub" },
            { "keys": "island switcher", "desc": "窗口切换页" },
            { "keys": "island wallpaper", "desc": "壁纸页" },
            { "keys": "island media", "desc": "媒体页" },
            { "keys": "island weather", "desc": "天气页" },
            { "keys": "island togglelayer", "desc": "岛层级切换" },
            { "keys": "island mediatoggle", "desc": "播放 / 暂停" },
            { "keys": "island medianext", "desc": "下一曲" },
            { "keys": "island mediaprevious", "desc": "上一曲" }
          ]
        },
        {
          "id": "ipc-sidebar",
          "title": "sidebar — view: time / sys / keys / todo",
          "items": [
            { "keys": "sidebar toggle", "desc": "开关" },
            { "keys": "sidebar open <view>", "desc": "切到指定页" },
            { "keys": "sidebar next", "desc": "下一页" },
            { "keys": "sidebar prev", "desc": "上一页" },
            { "keys": "sidebar close", "desc": "关闭" }
          ]
        },
        {
          "id": "ipc-rightbar",
          "title": "rightbar — view: network / bluetooth / audio / updates",
          "items": [
            { "keys": "rightbar toggle", "desc": "开关" },
            { "keys": "rightbar open <view>", "desc": "切到指定页" },
            { "keys": "rightbar next", "desc": "下一页" },
            { "keys": "rightbar prev", "desc": "上一页" },
            { "keys": "rightbar close", "desc": "关闭" }
          ]
        },
        {
          "id": "ipc-notif",
          "title": "notif — 通知中心",
          "items": [
            { "keys": "notif toggle", "desc": "开关" },
            { "keys": "notif open", "desc": "打开" },
            { "keys": "notif close", "desc": "关闭" },
            { "keys": "notif dnd", "desc": "免打扰" }
          ]
        },
        {
          "id": "ipc-window",
          "title": "浮动窗 — 均支持 toggle / open / close",
          "items": [
            { "keys": "free-window-app", "desc": "应用启动器" },
            { "keys": "free-window-clipboard", "desc": "剪贴板" },
            { "keys": "websearch", "desc": "搜索条" }
          ]
        },
        {
          "id": "ipc-lock",
          "title": "lock — 会话锁屏",
          "items": [
            { "keys": "lock lock", "desc": "锁屏" },
            { "keys": "lock status", "desc": "查锁定状态" }
          ]
        }
      ]
    }
  ]
}

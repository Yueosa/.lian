#!/usr/bin/env python3
"""qsl-archcheck —— 分层与接口的静态闸门

plan.md 的「架构约定」有 8 条，其中 4 条是机械可查的。这里把它们固化下来，
省得每一轮架构审计都重新手搓一遍 ripgrep（第 9 轮就是这么开场的）。

查四件事：

  1. 分层方向     谁能 import 谁。data 不许 import ui，Components 不许 import 业务
  2. 私有成员     UI 不得引用服务层 `_` 开头的成员（约定第 2 条）
  3. 令牌单一入口 UI 不得直接读 `Config.*`，只能走 `Size.*` / `Color.*`（约定第 7 条）
  4. 反向核对     UI 里写的每个 `Svc.member`，服务层必须真有这个成员

**第 4 条是本脚本存在的主要理由，也是 qmllint 查不出的那类。** QML 读一个不存在
的属性不报错，就是 `undefined`，然后一路静默地流进绑定——界面上是一块空白或者
一个 NaN，没有任何日志。2026-09-04 手工跑这条时当场抓到 `Bluetooth.connectedCount`：
UI 在用，服务层从来没定义过。

用法：
    scripts/qsl-archcheck            只报违规
    scripts/qsl-archcheck -v         连带打印每个单例的公开面尺寸
退出码非 0 = 有违规。
"""

from __future__ import annotations

import argparse
import re
import sys
from collections import defaultdict
from pathlib import Path

QSL = Path(__file__).resolve().parent.parent

# 单例根一律是 `Singleton {`，成员在深度 1。深度靠数花括号，不靠缩进——
# 缩进现在是一致的 4 空格，但那是习惯不是保证。
DECL = re.compile(
    r"""^\s*
    (?:readonly\s+)?
    (?:
        property\s+alias\s+(?P<alias>\w+)\s*:
      | property\s+[\w.<>]+\s+(?P<prop>\w+)
      | function\s+(?P<func>\w+)
      | signal\s+(?P<sig>\w+)
    )
    """,
    re.VERBOSE,
)

# `readonly property QtObject spacing: QtObject {` —— Size 把令牌按组收在嵌套的
# QtObject 里，于是调用点写的是两级：`Size.spacing.md`、`Size.island.overviewWidth`。
# 这两级恰恰是全树读得最多的东西（spacing 211 处、fontSize 272 处），
# 只查第一级等于闸门对着最大的一股流量敞开。
GROUP = re.compile(r"^\s*(?:readonly\s+)?property\s+QtObject\s+(\w+)\s*:\s*QtObject\s*\{")

LOADER_HEAD = re.compile(r"\bLoader\s*\{")
ACTIVE_DECL = re.compile(r"^\s*active\s*:", re.M)

PIXEL_LITERAL = re.compile(r"\bfont\.pixelSize\s*:\s*(\d+)\b")

# 第 9 轮盘下来真的是一次性尺寸的，挂在这。键是「文件:字号」而不是「文件:行号」——
# 行号会随着上下游改动漂走，字号不会。
BESPOKE_PX = {
    "Components/QslSlider.qml:18",        # 滑块把手上的刻度字形
    "ui/island/MediaLyrics.qml:26",       # 歌词焦点行，行高按它算死（见该处注释）
    "ui/island/MediaPage.qml:48",         # 无播放器时的空态音符
    "ui/island/MediaPage.qml:56",         # 封面缺图时的占位字形
    "ui/island/OverviewCalendar.qml:9",   # 格子右上角的农历/节气角标
    "ui/island/WallpaperPage.qml:22",     # 模式切换的大图标
    "ui/island/WeatherMetricTile.qml:18",  # 指标格左边那个字形图标
    "ui/island/WeatherNow.qml:52",        # 当前气温那个大数字
    "ui/leftbar/TimeClockCard.qml:38",    # 时钟主体
    "ui/leftbar/TodoTabsCard.qml:18",     # 标签页加号
    "ui/lock/LockClockHero.qml:22",       # 锁屏自成一套：浮在壁纸上，字号跟壳内不同源
    "ui/lock/LockMediaControls.qml:26",
    "ui/lock/LockPassword.qml:15",
    "ui/lock/LockLyrics.qml:32",          # 歌词焦点行 / 非焦点行
    "ui/lock/LockLyrics.qml:16",
    "ui/power/PowerCard.qml:22",          # 电源菜单的大图标
}

# Connections { target: X; function onFooChanged() {...} }
CONN_HEAD = re.compile(r"\bConnections\s*\{")
TARGET = re.compile(r"\btarget\s*:\s*(?:root\.)?(\w+)\b")
HANDLER = re.compile(r"\bfunction\s+(on[A-Z]\w*)\s*\(")

# 从 QtObject / Singleton 继承来的，不在源文件里但确实存在。
INHERITED = {"objectName", "destroy", "toString"}

# 分层规则：路径前缀 -> 不许 import 的模块前缀 + 一句人话理由。
FORBIDDEN = [
    ("data/", "qs.ui.", "数据层反过来依赖 UI，改一个面板会牵动服务"),
    ("data/", "qs.Components", "数据层依赖通用件层，Components 是给 UI 用的"),
    ("Components/", "qs.data.service", "通用件知道了业务，换个项目就搬不走"),
    ("Components/", "qs.ui.", "通用件依赖具体面板，等于不通用"),
    # 两个数据层的先后：service 在下，state 在上。
    #
    # 服务只认识外部世界（NM、BlueZ、Pipewire、Hyprland……），不认识本壳有几个
    # 面板、主题是深是浅——它是四层里最独立的一层，所以放最底下。状态层反过来
    # 是「这个壳此刻的样子」，天然要读服务：岛要知道有没有播放器在放
    # （Island→Media.active），要跳窗就得会跟 Hyprland 说话（Island→HyprService）。
    #
    # 定这个方向的直接原因是第 9 轮建 HyprService：派发窗口焦点那几个函数原先
    # 寄居在 Island 里，搬进服务之后 Island 必然依赖它。既然这条边是设计出来的，
    # 就不该让闸门红着——红的应该是反过来那条。
    ("data/service/", "qs.data.state", "服务层依赖状态层，方向反了；服务不该知道壳长什么样"),
]

# ui/frame 是框窗聚合器，它的本职就是把各个面板装进同一个 surface，
# 所以只有它可以横向 import qs.ui.*。
UI_AGGREGATOR = "ui/frame/"

# UI 不许自己伸手去够外部世界。每个外部系统只由一个服务单例代理，
# 这条规则就是那句话的机械形式。
#
# 第 9 轮之前 ui/bar 三个文件直连 SystemTray、ui/island 直连 Mpris、
# ui/bar 直连 Hyprland——同一份「怎么跟 SNI/MPRIS 说话」的知识在 UI 里散了
# 好几份，还各自漂移（托盘和启动器各写了一份 detectBundledAppId，一份认
# 「腾讯」一份认「tim」，答案不一样）。收完之后加这条闸门，是为了防止下一次
# 有人图省事再直接 import 一个回来。
EXTERNAL_IN_UI = ("Quickshell.Services.", "Quickshell.Io")

# 两处例外，都不是「还没来得及收」，是收了反而更糟：
EXTERNAL_IN_UI_EXEMPT = {
    # PamContext 的 start/abort 跟锁屏会话的生命周期绑死，搬进服务就得把
    # 生命周期也一起搬，而这条路径上出错的代价是把自己锁在外面。
    "ui/lock/LockContext.qml",
    # IpcHandler 的 target 是全局唯一的，只能在聚合器里挂一次（理由见该文件开头）。
    "ui/frame/FramePanels.qml",
}


# 一个 `/` 后面跟的是正则还是除号，只能看前一个有意义的字符。这几个之后
# 不可能是除号（没有左操作数），所以是正则开头。够用了：真实代码里的正则
# 都出现在 `= /.../`、`replace(/.../, x)`、`if (/.../.test(s))` 这三种位置。
REGEX_PRECEDERS = "(,=:[!&|?{};+-*~%"


def strip_noise(text: str) -> str:
    """去掉注释、字符串和正则字面量，免得里面的花括号和引号干扰深度计数。

    正则那一条是踩出来的：shell.js 的 quote() 里有（当时还在 HyprService）

        String(s).replace(/'/g, "'\\''")

    不认正则的话，`/` 原样放行，紧跟的 `'` 被当成字符串开头，一路吃到
    `"` 再开一段，于是这一行之后的整个文件都被当成字符串吞掉——文件里
    后半段的 function 一个都提取不到，闸门就报「接口不存在」。
    """
    out = []
    prev = ""  # 上一个有意义的字符（跳过空白）
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c == "/" and i + 1 < n:
            if text[i + 1] == "/":
                j = text.find("\n", i)
                i = n if j < 0 else j
                continue
            if text[i + 1] == "*":
                j = text.find("*/", i + 2)
                # 块注释里的换行要留着，否则行号会错位
                chunk = text[i : n if j < 0 else j + 2]
                out.append("\n" * chunk.count("\n"))
                i = n if j < 0 else j + 2
                continue
            if prev in REGEX_PRECEDERS or prev == "":
                i += 1
                in_class = False  # [...] 里的 / 不算结束
                while i < n and (in_class or text[i] != "/"):
                    if text[i] == "\\":
                        i += 1
                    elif text[i] == "[":
                        in_class = True
                    elif text[i] == "]":
                        in_class = False
                    i += 1
                i += 1
                while i < n and text[i].isalpha():  # 尾巴上的 g / i / m
                    i += 1
                out.append("0")
                prev = "0"
                continue
        if c in "\"'":
            quote, i = c, i + 1
            while i < n and text[i] != quote:
                i += 2 if text[i] == "\\" else 1
            i += 1
            out.append('""')
            prev = '"'
            continue
        out.append(c)
        if not c.isspace():
            prev = c
        i += 1
    return "".join(out)


def public_api(path: Path) -> set[str]:
    """单例的公开面，含分组令牌的第二级，返回点分路径的集合。

    深度 1 = 根元素直属的 property / function / signal。
    深度 2 只在「上一级是 QtObject 分组」时才算——别的深度 2 是子元素
    （Timer、Process、Connections…）的内部，外面够不着。
    """
    members: set[str] = set()
    group: str | None = None  # 当前所在的 QtObject 分组名，None = 不在分组里
    group_depth = 0
    depth = 0
    for line in strip_noise(path.read_text(encoding="utf-8")).splitlines():
        if depth == 1:
            g = GROUP.match(line)
            if g:
                group, group_depth = g.group(1), depth
                members.add(group)
            else:
                m = DECL.match(line)
                if m:
                    members.add(_named(m))
        elif group is not None and depth == group_depth + 1:
            m = DECL.match(line)
            if m:
                members.add(f"{group}.{_named(m)}")
        depth += line.count("{") - line.count("}")
        if group is not None and depth <= group_depth:
            group = None
    return members


def element_blocks(src: str, head_re: re.Pattern):
    """产出 (body, 起始行号)。花括号配对着数，别拿正则啃嵌套。"""
    for head in head_re.finditer(src):
        i = head.end() - 1  # 指向那个 {
        depth = 0
        for j in range(i, len(src)):
            if src[j] == "{":
                depth += 1
            elif src[j] == "}":
                depth -= 1
                if depth == 0:
                    yield src[i + 1 : j], src[:i].count("\n") + 1
                    break


def own_lines(body: str) -> str:
    """只留本层（depth 0）的行，跳过嵌套子元素里的同名属性。"""
    out, depth = [], 0
    for line in body.splitlines():
        if depth == 0:
            out.append(line)
        depth += line.count("{") - line.count("}")
    return "\n".join(out)


def connections_blocks(src: str):
    for body, lineno in element_blocks(src, CONN_HEAD):
        t = TARGET.search(body)
        if t:
            yield t.group(1), body, lineno


def _named(m: re.Match) -> str:
    return m.group("alias") or m.group("prop") or m.group("func") or m.group("sig")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("-v", "--verbose", action="store_true")
    args = ap.parse_args()

    qml = sorted(QSL.rglob("*.qml"))
    singletons = {
        p.stem: p for p in qml if "pragma Singleton" in p.read_text(encoding="utf-8")
    }
    api = {name: public_api(p) | INHERITED for name, p in singletons.items()}

    if args.verbose:
        print("单例公开面：")
        for name in sorted(api):
            rel = singletons[name].relative_to(QSL)
            print(f"  {name:<14} {len(api[name]) - len(INHERITED):>3} 个成员  {rel}")
        print()

    # 消费方：UI 和通用件。数据层内部互相调不在本脚本的管辖范围
    # （那是「谁该依赖谁」的问题，由分层方向那一节管）。
    consumers = [p for p in qml if _rel(p).startswith(("ui/", "Components/"))]
    use_re = re.compile(r"\b(" + "|".join(sorted(singletons)) + r")\.(\w+)(?:\.(\w+))?")
    # 哪些一级成员是 QtObject 分组（有二级可查）。不是分组的，后面那一截是
    # 不透明句柄的属性（`Media.activePlayer.title`），本脚本无从校验，放过。
    groups = {
        name: {m.split(".", 1)[0] for m in members if "." in m}
        for name, members in api.items()
    }

    findings: dict[str, list[str]] = defaultdict(list)

    for path in qml:
        rel = _rel(path)
        text = path.read_text(encoding="utf-8")
        for lineno, line in enumerate(text.splitlines(), 1):
            imp = line.strip()
            if not imp.startswith("import "):
                continue
            mod = imp.split()[1]
            for prefix, banned, why in FORBIDDEN:
                if rel.startswith(prefix) and mod.startswith(banned):
                    findings["分层方向"].append(f"{rel}:{lineno}  import {mod}  —— {why}")
            if (
                rel.startswith("ui/")
                and not rel.startswith(UI_AGGREGATOR)
                and mod.startswith("qs.ui.")
            ):
                findings["分层方向"].append(
                    f"{rel}:{lineno}  import {mod}  —— 面板之间横向依赖，"
                    f"只有 {UI_AGGREGATOR} 可以聚合"
                )
            if (
                rel.startswith("ui/")
                and rel not in EXTERNAL_IN_UI_EXEMPT
                and mod.startswith(EXTERNAL_IN_UI)
            ):
                findings["分层方向"].append(
                    f"{rel}:{lineno}  import {mod}  —— UI 直连外部系统，"
                    f"该由 data/service 下的单例代理"
                )

    for path in consumers:
        rel = _rel(path)
        for lineno, line in enumerate(
            strip_noise(path.read_text(encoding="utf-8")).splitlines(), 1
        ):
            for name, member, sub in use_re.findall(line):
                deep = member in groups[name]
                ref = f"{member}.{sub}" if deep and sub else member
                if member.startswith("_") or (deep and sub.startswith("_")):
                    findings["私有成员"].append(
                        f"{rel}:{lineno}  {name}.{ref}  —— 服务层私有，要什么就加公开面"
                    )
                elif ref not in api[name]:
                    findings["接口不存在"].append(
                        f"{rel}:{lineno}  {name}.{ref}  —— "
                        f"{_rel(singletons[name])} 里没有这个成员，运行时是 undefined"
                    )
                if name == "Config":
                    findings["令牌入口"].append(
                        f"{rel}:{lineno}  Config.{member}  —— 令牌只能走 Size.* / Color.*"
                    )

    # Loader 必须显式声明 active
    # ------------------------------------------------------------------
    # 默认 active: true 的意思是「建出来就再也不卸」，而 Loader 存在的理由
    # 多半正是想控制这个。不写就等于把生命周期交给默认值，且看代码的人
    # 无从判断这是深思熟虑还是忘了。第 9 轮盘点时 14 处全都写了，这条规则
    # 是拿来守住这个状态的。
    #
    # 真要常驻就写 `active: true` —— 一个字面量而已，但它把「我知道它不卸」
    # 和「我没想过」区分开了。
    for path in qml:
        rel = _rel(path)
        if rel.startswith(("backend/", "scripts/")):
            continue
        src = strip_noise(path.read_text(encoding="utf-8"))
        for body, lineno in element_blocks(src, LOADER_HEAD):
            if not ACTIVE_DECL.search(own_lines(body)):
                findings["生命周期"].append(
                    f"{rel}:{lineno}  Loader 没写 active —— 默认 true 是"
                    f"「建了就不卸」，常驻也请写明 active: true"
                )

    # 字号必须走排版阶
    # ------------------------------------------------------------------
    # 第 9 轮改名前，258 处走令牌、32 处直接写数字，后者散出 17 种字号。其中
    # 14/16/20/24 跟令牌上的档一模一样——纯属绕过，改版时改了令牌它们不跟着动。
    #
    # 剩下 15 处是真的一次性尺寸（9px 的日历角标、38/52px 的时钟与气温、
    # 48/56px 的装饰字形）。给每个装饰字形都发一个令牌，那就不是阶而是清单了，
    # 所以这些留字面量，在下面挂账。这条规则守的是「不再长出新的」。
    for path in qml:
        rel = _rel(path)
        if rel.startswith(("backend/", "scripts/")) or rel == "data/state/Size.qml":
            continue
        for lineno, line in enumerate(
            strip_noise(path.read_text(encoding="utf-8")).splitlines(), 1
        ):
            m = PIXEL_LITERAL.search(line)
            if m and f"{rel}:{m.group(1)}" not in BESPOKE_PX:
                findings["排版阶"].append(
                    f"{rel}:{lineno}  font.pixelSize: {m.group(1)}  —— "
                    f"字号走 Size.fontSize.* / 图标走 Size.iconSize.*；"
                    f"确实是一次性尺寸就加进 BESPOKE_PX 挂账"
                )

    # Connections 里的 on<属性>Changed / on<信号名>
    # ------------------------------------------------------------------
    # 上面那轮扫的是 `Service.member` 这种写法，扫不到
    #     Connections { target: Clipboard; function onRevisionChanged() {...} }
    # ——这里对服务的引用只出现在 target 上，成员名藏在处理器名里。
    #
    # 第 9 轮就因为这个吃过亏：grep `.revision` 得出「没人读」，把
    # Clipboard.revision 删了，其实 ClipHistory 正靠 onRevisionChanged 夹选择。
    # QML 只在运行时 WARN 一句「no signal of the target matches the name」，
    # 不报错、不中断，很容易漏过去。
    for path in consumers:
        rel = _rel(path)
        src = strip_noise(path.read_text(encoding="utf-8"))
        for target, body, lineno in connections_blocks(src):
            if target not in api:
                continue
            for handler in HANDLER.findall(body):
                # onXxx 有歧义，两种都得认：
                #   onTrackChanged  → 信号 trackChanged（Media 就是这么声明的）
                #   onRevisionChanged → 属性 revision 的变更信号
                # 任一存在就算数。
                bare = handler[2:]
                cands = {bare[:1].lower() + bare[1:]}
                if bare.endswith("Changed"):
                    prop = bare[:-7]
                    if prop:
                        cands.add(prop[:1].lower() + prop[1:])
                if cands & api[target]:
                    continue
                member = " / ".join(sorted(cands))
                findings["接口不存在"].append(
                    f"{rel}:~{lineno}  Connections(target: {target}) "
                    f"{handler}  —— {_rel(singletons[target])} 里 {member} 都不存在，"
                    f"这个处理器永远不会被调用"
                )

    if not findings:
        print(
            "架构闸门全绿：分层方向、私有成员、令牌入口、接口存在性、"
            "生命周期、排版阶六项无违规。"
        )
        return 0

    total = 0
    for section in (
        "分层方向", "接口不存在", "私有成员", "令牌入口", "生命周期", "排版阶"
    ):
        items = sorted(set(findings.get(section, [])))
        if not items:
            continue
        total += len(items)
        print(f"## {section}（{len(items)}）")
        for item in items:
            print(f"  {item}")
        print()
    print(f"合计 {total} 处违规。")
    return 1


def _rel(path: Path) -> str:
    return str(path.relative_to(QSL))


if __name__ == "__main__":
    sys.exit(main())

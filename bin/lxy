#!/usr/bin/env python3
"""lxy — 打开 mihomo WebUI"""
import subprocess, sys

URL = "http://proxy.lian.love"

if __name__ == "__main__":
    try:
        subprocess.Popen(
            ["xdg-open", URL],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        print(f"错误: 没有 xdg-open，手动打开 {URL}", file=sys.stderr)
        sys.exit(1)
    print(f"已打开 {URL}")

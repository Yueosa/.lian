#!/usr/bin/env bash
# dsh-open: dsh 进程起来后自动用其 token 打开一次兑换页。
#
# 由 dsh.service 的 ExecStartPost 调用（Type=simple，主进程 fork 即触发，
# 此时 token 可能已打印、也可能还没打印）。
# 事件驱动：journalctl -n 500 -f 先回读历史（token 已在日志则立即命中），
# 再阻塞跟随新增输出（还没打印则等它出现），grep -m1 命中第一行即退出。
# 不是轮询：单进程阻塞读，零周期唤醒。timeout 15 兜底防挂死。
#
# Chrome 打开带 token 的 URL 后，dsh 种下绑定 127.0.0.1:3080 的 cookie
# 并 303 到干净 /。cookie 有效期由 connection.cookieMaxAgeDays 决定
# （已 patch 为 3650 天，见 ~/.dsh/profiles/web/cordis.patch.yml）。
#
# 永远以 0 退出：兑换失败只丢一次自动登录，不影响 dsh 主服务
# （ExecStartPost 非零会让 Type=simple 服务整体失败）。
set +e
set -u

token="$(timeout 15 journalctl --user -u dsh.service -n 500 -f -o cat 2>/dev/null \
  | grep -m1 -oE 'token=[A-Za-z0-9_-]+' | cut -d= -f2)"

if [ -n "${token:-}" ]; then
  /usr/bin/google-chrome-stable "http://127.0.0.1:3080/?token=${token}" >/dev/null 2>&1
fi

exit 0
